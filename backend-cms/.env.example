# Direct npm development requires a PostgreSQL database supplied by the developer.
DATABASE_URI=postgresql://payload:replace-me@localhost:5432/atf_cms

PAYLOAD_DEV_BIND_ADDRESS=0.0.0.0
PAYLOAD_DEV_PORT=3001
PAYLOAD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
PAYLOAD_PUBLIC_SITE_ORIGIN=http://localhost:3000
PAYLOAD_SECRET=replace-with-a-long-random-development-secret
