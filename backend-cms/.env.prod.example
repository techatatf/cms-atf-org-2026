# PostgreSQL receives these values when the production Compose application starts.
POSTGRES_DB=atf_cms
POSTGRES_USER=payload
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Keep DATABASE_URI aligned with the PostgreSQL values above.
# URL-encode reserved characters in the database password.
DATABASE_URI=postgresql://payload:replace-with-a-long-random-database-password@postgres:5432/atf_cms

PAYLOAD_SECRET=replace-with-at-least-thirty-two-random-characters

# Configure one Backend CMS and Public Site pair per deployment.
# Production uses https://cms.africantechnologyforum.org with https://africantechnologyforum.org.
# Demo uses https://cms-demo.africantechnologyforum.org with https://public-demo.africantechnologyforum.org.
# Do not mix production and demo origins in one deployment.
# PAYLOAD_PUBLIC_SITE_ORIGIN sets the Public Site origin for Live Preview.
# PAYLOAD_ALLOWED_ORIGINS must include the exact Backend CMS and Public Site origins.
PAYLOAD_PUBLIC_SERVER_URL=https://cms.example.org
PAYLOAD_PUBLIC_SITE_ORIGIN=https://www.example.org
PAYLOAD_ALLOWED_ORIGINS=https://cms.example.org,https://www.example.org

# The host reverse proxy can reach this loopback port. PostgreSQL has no host port.
PAYLOAD_BIND_ADDRESS=127.0.0.1
PAYLOAD_PORT=3001
